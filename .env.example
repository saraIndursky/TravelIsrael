# ─────────────────────────────────────────────────────────────
# TravelIsrael — משתני סביבה
# העתיקו קובץ זה ל-.env.local ומלאו את הערכים.
# כל משתנה שמתחיל ב-NEXT_PUBLIC_ נחשף לדפדפן — אין להכניס בו סודות.
# שינוי של משתנה NEXT_PUBLIC_ דורש הפעלה מחדש של שרת הפיתוח.
# ─────────────────────────────────────────────────────────────

# ── Supabase (חובה) ──────────────────────────────────────────

# כתובת הפרויקט: Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# מפתח ציבורי לקריאה/כתיבה תחת RLS.
# מספיק להגדיר אחד מהשניים — הקוד מעדיף את ANON_KEY ונופל ל-PUBLISHABLE_KEY.
# Dashboard → Settings → API → Project API keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# באיזו סכמה במסד להשתמש: public (ברירת מחדל) או demo.
# סכמת demo מכילה נתוני בדיקה עשירים ומאפשרת לבדוק זרימות בלי לגעת בפרודקשן.
# דרישה חד-פעמית: להוסיף את demo ל-Settings → API → Exposed schemas בדשבורד.
NEXT_PUBLIC_SUPABASE_SCHEMA=public

# ── Bootstrap admin (אופציונלי) ──────────────────────────────

# האימייל שיקבל תמיד תפקיד admin בהתחברות.
# אם ריק — המשתמש הראשון שנרשם למערכת הופך למנהל.
NEXT_PUBLIC_BOOTSTRAP_ADMIN_EMAIL=

# ── עוזר AI (אופציונלי) ──────────────────────────────────────

# demo (ברירת מחדל) = עוזר מקומי מבוסס חוקים, בלי קריאות חוץ ובלי עלות.
# gemini = Google Gemini (יש מכסה חינמית ב-https://aistudio.google.com/apikey).
# openai = OpenAI (בתשלום). אם המפתח של הספק שנבחר חסר — נופל אוטומטית ל-demo.
ASSISTANT_MODE=demo

# מפתחות — משתני שרת בלבד (ללא NEXT_PUBLIC_), לא נחשפים לדפדפן.
GEMINI_API_KEY=
# אופציונלי: ברירת מחדל gemini-2.5-flash
GEMINI_MODEL=
OPENAI_API_KEY=

# ── אימייל (Resend — אופציונלי) ───────────────────────────────

# בלי RESEND_API_KEY — המערכת עובדת כרגיל, פשוט לא שולחת מיילים.
# Dashboard → API Keys: https://resend.com/api-keys
RESEND_API_KEY=

# כתובת השולח. בדמו אפשר onboarding@resend.dev (רק לכתובות שאימתתם).
RESEND_FROM_EMAIL=TravelIsrael <onboarding@resend.dev>

# כתובת האתר לקישורים במיילים (פרודקשן: https://your-domain.com).
# חובה גם לאיפוס סיסמה — הוסיפו ב-Supabase Auth → URL Configuration:
#   Redirect URLs: http://localhost:3000/auth/callback** (ופרודקשן בהתאם)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── סקריפטים (אופציונלי) ─────────────────────────────────────

# כתובת הבסיס ש-`npm run verify:dev` בודק מולה.
DEV_URL=http://localhost:3000

# ── Analytics (אופציונלי — production) ────────────────────────

# none (ברירת מחדל) | vercel | plausible
# ב-dev לא נטען — אלא אם NEXT_PUBLIC_ANALYTICS_DEBUG=true
NEXT_PUBLIC_ANALYTICS_PROVIDER=

# נדרש כש-provider=plausible (למשל your-domain.com)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# לאפשר בדיקה מקומית של trackEvent + scripts
NEXT_PUBLIC_ANALYTICS_DEBUG=

# חשבון בדיקה לזרימות login/profile/create trip. בלי אלה — רק wizard רץ (אם Supabase מוגדר).
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# אופציונלי: מנהל נפרד ל-E2E של דחייה→עריכה→אישור. אם ריק — משתמשים ב-E2E_USER (צריך להיות admin).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# אופציונלי: מנהל נפרד ל-E2E של עריכה → דחייה → אישור. בלי זה משתמשים ב-E2E_USER (חייב להיות admin).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
