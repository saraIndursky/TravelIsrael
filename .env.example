# ─────────────────────────────────────────────────────────────
# TravelIsrael — environment variables
# Copy this file to .env.local and fill in the values.
# Every variable that starts with NEXT_PUBLIC_ is exposed to the browser — never put secrets in it.
# Changing a NEXT_PUBLIC_ variable requires restarting the dev server.
# ─────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────

# Project URL: Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public key for reads/writes under RLS.
# Set one of the two — the code prefers ANON_KEY and falls back to PUBLISHABLE_KEY.
# Dashboard → Settings → API → Project API keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Which database schema to use: public (default) or demo.
# The demo schema has rich test data for testing flows without touching production.
# One-time step: add demo under Settings → API → Exposed schemas in the dashboard.
NEXT_PUBLIC_SUPABASE_SCHEMA=public

# ── Bootstrap admin (optional) ───────────────────────────────

# This email always gets the admin role on login.
# If empty, the first user who signs up becomes the admin.
NEXT_PUBLIC_BOOTSTRAP_ADMIN_EMAIL=

# ── AI assistant (optional) ──────────────────────────────────

# demo (default) = local rule-based assistant, no external calls and no cost.
# gemini = Google Gemini (free quota at https://aistudio.google.com/apikey).
# openai = OpenAI (paid). If the selected provider's key is missing, falls back to demo.
ASSISTANT_MODE=demo

# Keys — server-only variables (no NEXT_PUBLIC_), never exposed to the browser.
GEMINI_API_KEY=
# Optional: defaults to gemini-flash-lite-latest (fast and stable). Best left empty.
GEMINI_MODEL=
OPENAI_API_KEY=

# ── Email (Resend, optional) ─────────────────────────────────

# Without RESEND_API_KEY the app works normally but does not send emails.
# Dashboard → API Keys: https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. For a demo you can use onboarding@resend.dev (only to verified addresses).
RESEND_FROM_EMAIL=TravelIsrael <onboarding@resend.dev>

# Site URL for links in emails (production: https://your-domain.com).
# Also required for password reset — add it in Supabase Auth → URL Configuration:
#   Redirect URLs: http://localhost:3000/auth/callback** (and the production URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Scripts (optional) ───────────────────────────────────────

# Base URL that `npm run verify:dev` checks.
DEV_URL=http://localhost:3000

# ── Analytics (optional, production) ─────────────────────────

# none (default) | vercel | plausible
# Not loaded in dev unless NEXT_PUBLIC_ANALYTICS_DEBUG=true
NEXT_PUBLIC_ANALYTICS_PROVIDER=

# Required when provider=plausible (e.g. your-domain.com)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Enables local testing of trackEvent and scripts
NEXT_PUBLIC_ANALYTICS_DEBUG=

# Test account for the login/profile/create-trip flows. Without it only the wizard runs (if Supabase is set).
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Optional: a separate admin for the edit → reject → approve E2E. If empty, E2E_USER is used (must be an admin).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# ── Contact ──────────────────────────────────────────────────

# Where each new contact message is emailed (requires RESEND_API_KEY). Optional —
# messages are always saved in the database and shown in the admin panel (/admin/messages).
CONTACT_RECIPIENT_EMAIL=

# Email address shown on the contact page. If empty, no address is shown.
NEXT_PUBLIC_CONTACT_EMAIL=
